import numpy as np
import matplotlib.pyplot as plt

b = 2.5
d = 2
delta = 1.5
tau = 1
    
def f(H, I):
    return (b - d)*H - delta*I

def g(H, I):
    return tau*I*(H - I) - (delta + d)*I

H = np.linspace(0, 10, 100)
I= np.linspace(0, 10, 100)


I_H_null = (b - d)*H/delta
I_I_null = H- (delta + d)/tau


plt.figure(figsize=(8, 6))

plt.plot(H, I_H_null, label="H-nullcline")
plt.plot(H, I_I_null, label="I-nullcline")
plt.axhline(0, color="black", linewidth=0.8)

plt.xlim(0, 10)
plt.ylim(0, 8)
plt.xlabel("Population of Healthy Rabbits, H")
plt.ylabel("Population of Infected Rabbots, I")
plt.title("Nullcline of the System")
plt.legend()

